{
  "$schema": "node_modules/wrangler/config-schema.json",

  // This is the Worker already serving salimelbaye.com (custom domain
  // salimelbaye.com -> service "salimelbaye", production). Deploying with this
  // config UPDATES that Worker. Changing the name would create a second Worker
  // and leave the live site on the old one.
  "name": "salimelbaye",
  "main": ".open-next/worker.js",

  // Only at salimelbaye.com: no second public copy of the site on
  // *.workers.dev, and no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,

  // Matches the deployed Worker's date exactly, so promoting a new version
  // changes the application code and nothing about the runtime.
  "compatibility_date": "2026-08-31",
  // nodejs_compat is required by @opennextjs/cloudflare: the server bundle
  // imports node:async_hooks, node:buffer, node:crypto, node:stream and others.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // ASSETS serves the static files, IMAGES backs the /_next/image optimiser the
  // public site's portrait depends on, and WORKER_SELF_REFERENCE is how
  // OpenNext revalidates. None of them may be dropped.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "images": {
    "binding": "IMAGES"
  },

  "services": [
    {
      // The service name must equal the Worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "salimelbaye",
      "environment": "production"
    }
  ],

  // Where OpenNext persists regenerated ISR pages. Without this the
  // homepage's background revalidation never completes and the request is
  // cancelled — see open-next.config.ts.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "12fd42be306f468e9c418b9d24deadd4"
    }
  ],

  // Data from the private /us app, which has been removed from the code. No
  // code reads this binding any more; it is kept so the database and every row
  // in it stay attached and documented. Unbinding it would not delete the data,
  // but `wrangler d1 delete hajar-salim` would, permanently.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hajar-salim",
      "database_id": "04c593c5-1d27-473d-9b95-e57f8477c360",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }
}
